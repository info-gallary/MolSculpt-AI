# Copy this file to .env and paste your Groq API key (https://console.groq.com/keys)
GROQ_API_KEY=
# Optional: default model for the agent (any tool-capable Groq model)
GROQ_MODEL=openai/gpt-oss-120b
# Optional: server port / host (keep 127.0.0.1 so the key-holding server is not exposed on the network)
PORT=5173
HOST=127.0.0.1
